#!/usr/bin/env sh
set -e

# --concurrency=1 is deliberate. The task is IO-bound here (it waits on an
# HTTP call), so concurrency could be higher - but the Ollama host has 2
# OCPUs and serves one generation at a time. Concurrency 1 backpressures
# against the real bottleneck instead of queueing requests it cannot serve.
#
# --beat is embedded, which is ONLY safe while this process group has
# exactly one machine. `fly scale count worker=2` would double every
# scheduled reap. Promote beat to its own process group before scaling.
#
# --schedule is explicit and MUST stay that way. Beat's default
# (`celerybeat-schedule`, relative to CWD `/app`) is unwritable: the
# Dockerfile deliberately leaves /app root-owned and read-only to appuser
# so collectstatic's output can't be tampered with at runtime. Because
# embedded beat runs as a multiprocessing.Process child of the worker, a
# failure to open its schedule file does NOT crash the worker - the worker
# keeps consuming the queue while beat quietly dies on every boot, so
# scheduled reaping silently never runs. Do not "tidy" this flag away.
#
# --without-heartbeat/gossip/mingle are a Redis cost control. The heartbeat
# alone PUBLISHes every 2s (~43k commands/day) even with task events off,
# because gossip and heartbeat keep the event dispatcher enabled. All three
# exist for multi-worker coordination and monitors like Flower; with one
# worker and no monitor they buy nothing. See CELERY_BROKER_TRANSPORT_OPTIONS
# in settings.py for the polling side of the same budget.
exec celery -A sleep_tracker worker \
  --concurrency=1 \
  --without-heartbeat \
  --without-gossip \
  --without-mingle \
  --beat \
  --schedule=/tmp/celerybeat-schedule \
  --loglevel=info
